// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  disabled
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  displayName  String?    @map("display_name") @db.VarChar(80)
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  companies Company[]
  contacts  Contact[]

  @@map("users")
}

enum CompanySize {
  solo
  size_1_10   @map("1-10")
  size_11_50  @map("11-50")
  size_51_200 @map("51-200")
  size_200_plus @map("200+")
}

model Company {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  name      String       @db.VarChar(120)
  website   String?      @db.VarChar(255)
  industry  String?      @db.VarChar(80)
  size      CompanySize?
  notes     String?      @db.VarChar(2000)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts Contact[]

  @@unique([userId, name], map: "companies_user_id_name_unique")
  @@index([userId], map: "companies_user_id_idx")
  @@index([name], map: "companies_name_idx")
  @@map("companies")
}

enum ContactSource {
  freelance
  inbound
  referral
  linkedin
  cold
  other
}

enum ContactStatus {
  lead
  contacted
  qualified
  customer
  inactive
}

model Contact {
  id              String         @id @default(uuid())
  userId          String         @map("user_id")
  companyId       String?        @map("company_id")
  firstName       String?        @map("first_name") @db.VarChar(60)
  lastName        String?        @map("last_name") @db.VarChar(60)
  email           String?        @db.VarChar(255)
  phone           String?        @db.VarChar(40)
  title           String?        @db.VarChar(80)
  source          ContactSource?
  status          ContactStatus  @default(lead)
  lastContactedAt DateTime?      @map("last_contacted_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@unique([userId, email], map: "contacts_user_id_email_unique")
  @@index([userId], map: "contacts_user_id_idx")
  @@index([companyId], map: "contacts_company_id_idx")
  @@index([status], map: "contacts_status_idx")
  @@map("contacts")
}
