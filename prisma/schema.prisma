// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanySize {
  solo
  size_1_10     @map("1-10")
  size_11_50    @map("11-50")
  size_51_200   @map("51-200")
  size_200_plus @map("200+")
}

model Company {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  name      String       @db.VarChar(120)
  website   String?      @db.VarChar(255)
  industry  String?      @db.VarChar(80)
  size      CompanySize?
  notes     String?      @db.VarChar(2000)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  contacts     Contact[]
  deals        Deal[]
  interactions Interaction[]
  tasks        Task[]

  @@unique([userId, name], map: "companies_user_id_name_unique")
  @@index([userId], map: "companies_user_id_idx")
  @@index([name], map: "companies_name_idx")
  @@map("companies")
}

enum ContactSource {
  freelance
  inbound
  referral
  linkedin
  cold
  other
}

enum ContactStatus {
  lead
  contacted
  qualified
  customer
  inactive
}

model Contact {
  id              String         @id @default(uuid())
  userId          String         @map("user_id")
  companyId       String?        @map("company_id")
  firstName       String?        @map("first_name") @db.VarChar(60)
  lastName        String?        @map("last_name") @db.VarChar(60)
  email           String?        @db.VarChar(255)
  phone           String?        @db.VarChar(40)
  title           String?        @db.VarChar(80)
  source          ContactSource?
  status          ContactStatus  @default(lead)
  lastContactedAt DateTime?      @map("last_contacted_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deals        Deal[]
  interactions Interaction[]
  tasks        Task[]

  @@unique([userId, email], map: "contacts_user_id_email_unique")
  @@index([userId], map: "contacts_user_id_idx")
  @@index([companyId], map: "contacts_company_id_idx")
  @@index([status], map: "contacts_status_idx")
  @@map("contacts")
}

enum DealStage {
  lead
  discovery
  proposal
  negotiation
  won
  lost
}

model Deal {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  title             String    @db.VarChar(120)
  contactId         String?   @map("contact_id")
  companyId         String?   @map("company_id")
  stage             DealStage @default(lead)
  valueCents        Int?      @map("value_cents")
  currency          String    @default("CAD") @db.VarChar(3)
  probability       Int?
  expectedCloseDate DateTime? @map("expected_close_date") @db.Date
  lostReason        String?   @map("lost_reason") @db.VarChar(300)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  interactions Interaction[]
  tasks        Task[]

  @@index([userId], map: "deals_user_id_idx")
  @@index([contactId], map: "deals_contact_id_idx")
  @@index([companyId], map: "deals_company_id_idx")
  @@map("deals")
}

enum InteractionType {
  call
  meeting
  email
  message
  demo
  note
}

model Interaction {
  id         String          @id @default(uuid())
  userId     String          @map("user_id")
  type       InteractionType
  occurredAt DateTime        @map("occurred_at")
  summary    String          @db.VarChar(2000)
  contactId  String?         @map("contact_id")
  companyId  String?         @map("company_id")
  dealId     String?         @map("deal_id")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deal    Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([userId], map: "interactions_user_id_idx")
  @@index([contactId], map: "interactions_contact_id_idx")
  @@index([dealId], map: "interactions_deal_id_idx")
  @@map("interactions")
}

enum TaskStatus {
  open
  done
  canceled
}

enum TaskPriority {
  low
  medium
  high
}

model Task {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  title       String       @db.VarChar(160)
  description String?      @db.VarChar(2000)
  dueAt       DateTime?    @map("due_at")
  status      TaskStatus   @default(open)
  priority    TaskPriority @default(medium)
  contactId   String?      @map("contact_id")
  companyId   String?      @map("company_id")
  dealId      String?      @map("deal_id")
  completedAt DateTime?    @map("completed_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deal    Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([userId], map: "tasks_user_id_idx")
  @@index([contactId], map: "tasks_contact_id_idx")
  @@index([dealId], map: "tasks_deal_id_idx")
  @@map("tasks")
}
