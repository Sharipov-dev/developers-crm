# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/myapp_dev?schema=public"

# Database (SQLite - uncomment to use for quick local dev)
# DATABASE_URL="file:./dev.db"

# Logging
LOG_LEVEL=debug

# Pagination defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
